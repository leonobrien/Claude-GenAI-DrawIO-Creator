{
  "name": "drawio-skill",
  "version": "0.1.0",
  "description": "Claude Code skill for programmatic draw.io diagram generation, revision, and management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "audit:security": "eslint 'src/**/*.ts' --plugin secure-coding --rule 'secure-coding/all: error'",
    "audit:complexity": "eslintcc src/ --max-rank C",
    "audit:all": "npm run audit:security && npm run audit:complexity && npm audit",
    "check:types": "tsc --noEmit",
    "audit:strict": "npm run check:types && npm run audit:all"
  },
  "keywords": [
    "drawio",
    "diagram",
    "claude-code",
    "skill"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.3",
    "eslint-plugin-secure-coding": "^3.1.3",
    "eslint-plugin-security": "^4.0.0",
    "eslintcc": "^0.8.3",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.13.0",
    "fast-xml-parser": "^5.1.0"
  }
}
