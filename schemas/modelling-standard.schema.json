{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowble.io/schemas/modelling-standard.schema.json",
  "title": "Client Modelling Standard",
  "description": "Defines the elements, connectors and containers a client permits in diagrams for one modelling domain. Stored at clients/<client-id>/standards/<standard-id>.json.",
  "type": "object",
  "required": ["name", "domain", "baseNotation"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$", "description": "Defaults to the file name." },
    "clientId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$", "description": "Defaults to the client directory name." },
    "name": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1, "examples": ["software", "business-architecture", "infrastructure", "process"] },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "baseNotation": { "enum": ["generic", "aws", "azure", "gcp", "cisco", "archimate", "uml", "bpmn", "fortinet", "infographic"] },
    "enforcement": { "enum": ["strict", "warn"], "default": "strict" },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["manual", "generated"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": { "path": { "type": "string" }, "sha256": { "type": "string" } }
          }
        }
      }
    },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "connectors": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "palette": {
      "type": "object",
      "properties": {
        "fills": { "type": "array", "items": { "type": "string" } },
        "strokes": { "type": "array", "items": { "type": "string" } },
        "fonts": { "type": "array", "items": { "type": "string" } },
        "fontColours": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "lockPalette": { "type": "boolean", "default": false, "description": "Colours must come from the palette." },
        "lockElementStyle": { "type": "boolean", "default": false, "description": "Fill, stroke, stroke width and font must match the element's style exactly." },
        "allowFreeText": { "type": "boolean", "default": false, "description": "Permit text annotation cells not defined as elements." }
      }
    },
    "promptRules": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["name"],
      "anyOf": [{ "required": ["style"] }, { "required": ["ref"] }],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["vertex", "edge", "container"], "description": "Implied by the list it appears in." },
        "style": { "type": "string", "description": "Canonical draw.io style string." },
        "ref": { "type": "string", "pattern": "^[a-z]+:.+$", "description": "Built-in shape reference, e.g. \"archimate:Application Component\"." },
        "identity": { "type": "string", "description": "Computed from style when omitted." },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "defaultWidth": { "type": "number" },
        "defaultHeight": { "type": "number" },
        "needsName": { "type": "boolean" }
      }
    }
  }
}
